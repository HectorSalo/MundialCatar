<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp"
    app:strokeColor="@color/garnet_normal"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- FILA SUPERIOR: fecha (izquierda) + ronda (derecha) -->

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_round"
            app:layout_constraintHorizontal_bias="0"
            tools:text="21 Nov 2022 · 11:00" />

        <TextView
            android:id="@+id/tv_round"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/tv_date"
            app:layout_constraintBottom_toBottomOf="@+id/tv_date"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Grupo A · Jornada 1" />

        <!-- SECCIÓN CENTRAL: equipo local vs visitante -->

        <!-- Equipo local -->
        <ImageView
            android:id="@+id/iv_flag1"
            android:layout_width="@dimen/size_image_flag_width"
            android:layout_height="@dimen/size_image_flag_height"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_flag_24"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/iv_flag2"
            android:layout_marginTop="8dp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_team1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:textSize="@dimen/size_text_results"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@+id/iv_flag1"
            app:layout_constraintBottom_toBottomOf="@+id/iv_flag1"
            app:layout_constraintStart_toEndOf="@+id/iv_flag1"
            app:layout_constraintEnd_toStartOf="@+id/tv_result1"
            tools:text="@string/text_team" />

        <TextView
            android:id="@+id/tv_result1"
            android:layout_width="@dimen/size_image_flag_width"
            android:layout_height="@dimen/size_image_flag_width"
            android:gravity="center"
            android:textSize="@dimen/size_text_results"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@+id/iv_flag1"
            app:layout_constraintBottom_toBottomOf="@+id/iv_flag1"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="2" />

        <!-- Equipo visitante -->
        <ImageView
            android:id="@+id/iv_flag2"
            android:layout_width="@dimen/size_image_flag_width"
            android:layout_height="@dimen/size_image_flag_height"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_flag_24"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/iv_flag1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_stadium"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_team2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:textSize="@dimen/size_text_results"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@+id/iv_flag2"
            app:layout_constraintBottom_toBottomOf="@+id/iv_flag2"
            app:layout_constraintStart_toEndOf="@+id/iv_flag2"
            app:layout_constraintEnd_toStartOf="@+id/tv_result2"
            tools:text="@string/text_team" />

        <TextView
            android:id="@+id/tv_result2"
            android:layout_width="@dimen/size_image_flag_width"
            android:layout_height="@dimen/size_image_flag_width"
            android:gravity="center"
            android:textSize="@dimen/size_text_results"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@+id/iv_flag2"
            app:layout_constraintBottom_toBottomOf="@+id/iv_flag2"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="1" />

        <!-- FILA INFERIOR: estadio + ciudad -->

        <TextView
            android:id="@+id/tv_stadium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="normal"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@+id/iv_flag2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_location"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="8dp"
            tools:text="Estadio Lusail" />

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/tv_stadium"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stadium"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Lusail, Qatar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
